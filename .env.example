# Copy to .env and adjust: cp .env.example .env
# Every variable is optional; the defaults are shown.

# --- AI ----------------------------------------------------------------------
# Without a key the chat runs in DEMO MODE (scripted buttons), so it always works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible API works too:
# OPENAI_BASE_URL=https://api.openai.com/v1
# Reasoning models (gpt-5*, o*): set an effort and raise MAX_REPLY_TOKENS.
# OPENAI_REASONING_EFFORT=minimal
# OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT_SECONDS=20

# --- Admin (/admin) ----------------------------------------------------------
# If empty, a random password is generated at startup and printed in the logs.
ADMIN_PASSWORD=
# Signs the admin cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Cost and abuse protection -----------------------------------------------
RATE_LIMIT_MESSAGES=20          # chat messages per IP...
RATE_LIMIT_WINDOW_SECONDS=600   # ...per 10 minutes
DAILY_MESSAGE_CAP=500           # AI-answered messages per day (all visitors)
DAILY_TOKEN_CAP=1000000         # tokens per day (all visitors); then demo mode
MAX_REPLY_TOKENS=350            # per model call
MAX_MESSAGE_CHARS=500
HISTORY_MESSAGES=20             # conversation memory sent to the model
MAX_BOOKINGS_PER_SESSION=3

# --- Demo data -----------------------------------------------------------------
DATA_RETENTION_HOURS=24         # bookings and chats are deleted after this
MAINTENANCE_INTERVAL_MINUTES=15
SEED_DEMO_DATA=true             # example bookings so the calendar is never empty

# --- Site ------------------------------------------------------------------------
AGENCY_NAME=Liminova
CONTACT_EMAIL=contact@exemplu.ro
TIMEZONE=Europe/Bucharest
COOKIE_SECURE=auto              # auto: Secure cookies when served over HTTPS
API_DOCS=false                  # true: OpenAPI docs at /api/docs
LOG_LEVEL=info
# DATABASE_URL=sqlite:///./data/clinic.db   (docker-compose uses /app/data/clinic.db)
